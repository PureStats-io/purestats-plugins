{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "purestats": {
            "type": "streamable-http",
            "url": "https://purestats.io/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "cimd"
                        },
                        "resource": "https://purestats.io/mcp",
                        "baseScopes": [
                            "account:read",
                            "sites:read",
                            "analytics:read"
                        ]
                    }
                }
            }
        }
    }
}
